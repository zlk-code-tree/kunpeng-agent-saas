# 复制为 deploy/.env.prod 后再填写真实值。不要提交包含真实密钥的文件。
APP_MODE=single
DATABASE_URL=postgres://gin_dify:gin_dify@postgres:5432/gin_dify?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-another-32-character-secret
S3_ACCESS_KEY=gin-dify
S3_SECRET_KEY=replace-with-a-strong-s3-secret
S3_BUCKET=gin-dify
CORS_ORIGINS=http://localhost
WEB_PORT=80
