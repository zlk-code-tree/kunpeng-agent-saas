APP_ENV=development
APP_MODE=single
HTTP_ADDR=:8080
DATABASE_URL=postgres://gin_dify:gin_dify@127.0.0.1:15432/gin_dify?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-another-32-character-secret
JWT_TTL=2h
CORS_ORIGINS=http://localhost:5777
DIFY_BASE_URL=http://127.0.0.1:5001/v1
DIFY_TIMEOUT=120s
S3_ENDPOINT=http://127.0.0.1:18333
S3_ACCESS_KEY=gin-dify
S3_SECRET_KEY=gin-dify-secret
S3_BUCKET=gin-dify
S3_USE_SSL=false

